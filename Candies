
public static long candies(int n, List<int> arr)
{
    int[] count = new int[n];

    for (int i = 0; i < n; i++)
    {
        count[i] = 1;
    }

    for (int i = 1; i < n; i++)
    {
        if (arr[i] > arr[i - 1])
        {
            count[i] = count[i - 1] + 1;
        }
    }

    for (int i = n - 2; i >= 0; i--)
    {
        if (arr[i] > arr[i + 1] && count[i] <= count[i + 1])
        {
            count[i] = count[i + 1] + 1;
        }
    }

    long total = 0;

    for (int i = 0; i < n; i++)
    {
        total += count[i];
    }

    return total;
}
