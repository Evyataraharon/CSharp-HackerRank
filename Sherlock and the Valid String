
public static string isValid(string s)
{
    int[] count = new int[26];

    foreach (char c in s)
    {
        count[c - 'a']++;
    }

    for (int removed = -1; removed < 26; removed++)
    {
        if (removed >= 0 && count[removed] == 0)
        {
            continue;
        }

        if (removed >= 0)
        {
            count[removed]--;
        }

        int frequency = 0;
        bool valid = true;

        for (int i = 0; i < 26; i++)
        {
            if (count[i] == 0)
            {
                continue;
            }

            if (frequency == 0)
            {
                frequency = count[i];
            }
            else if (frequency != count[i])
            {
                valid = false;
                break;
            }
        }

        if (removed >= 0)
        {
            count[removed]++;
        }

        if (valid)
        {
            return "YES";
        }
    }

    return "NO";
}
