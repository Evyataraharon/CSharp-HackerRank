
public static int maxMin(int k, List<int> arr)
{
    arr.Sort();

    int minDiff = int.MaxValue;

    for (int i = 0; i <= arr.Count - k; i++)
    {
        int diff = arr[i + k - 1] - arr[i];

        if (diff < minDiff)
        {
            minDiff = diff;
        }
    }

    return minDiff;
}
